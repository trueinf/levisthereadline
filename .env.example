# Copy this file to `.env` and paste your OpenAI API key.
#
#   cp .env.example .env
#
# The key is read only by the backend (server/config.js). It is never imported
# by the frontend and never ends up in the browser bundle.
#
# `server/` is its own npm package and can run standalone; it looks for
# `server/.env` first and falls back to this root `.env`, so either location
# works from either directory.

OPENAI_API_KEY=


# ---- Optional --------------------------------------------------------------
# Defaults are fine for local development; you can delete these lines.
#
# PORT=8787            backend port (the Vite dev proxy follows it automatically)
# HOST=0.0.0.0         bind address
# NODE_ENV=production  set on your server; enables asset caching, hides stack traces
# LOG_LEVEL=info       debug | info | warn | error
#
# Everything else (timeouts, allowed models, rate limits, CORS) is a constant in
# server/config.js — edit it there if you ever need to change it.
