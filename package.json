{
  "name": "threadline",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Threadline — Levi's Agentic Content Orchestration prototype (React + TypeScript frontend; the backend is its own package in server/)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "cd server && npm install --no-audit --no-fund",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "cd server && npm run dev",
    "build": "tsc -b && vite build",
    "start": "cd server && npm start",
    "serve": "npm run build && npm start",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
